{
  "project_name": "Spring Modulith Application",
  "project_slug": "{{ cookiecutter.project_name|lower|replace(' ', '-')|replace('_', '-') }}",
  "project_description": "A modular monolith built with Spring Boot and Spring Modulith.",
  "package_name": "com.example.{{ cookiecutter.project_slug|replace('-', '')|replace('_', '') }}",
  "java_version": ["21", "25"],
  "spring_boot_version": ["4.2.0", "4.1.3"],
  "build_tool": ["gradle-kotlin"],
  "database": ["postgresql"],
  "migration_tool": ["flyway"],
  "include_identity_module": true,
  "include_notifications_module": true,
  "include_audit_module": true,
  "include_rabbitmq": true,
  "include_stomp": true,
  "include_docker_compose": true,
  "include_testcontainers": true,
  "include_observability": true,
  "_copy_without_render": [
    "gradlew",
    "gradlew.bat",
    "gradle/wrapper/gradle-wrapper.jar"
  ]
}
