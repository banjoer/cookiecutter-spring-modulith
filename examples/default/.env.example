# Local development values only. Copy this file to .env and replace the passwords.
# Never commit .env and never reuse these values in a real environment.
POSTGRES_DB=application
POSTGRES_USERNAME=application
POSTGRES_PASSWORD=replace-with-a-local-password

APP_PORT=8080

RABBITMQ_USERNAME=application
RABBITMQ_PASSWORD=replace-with-a-local-password
STOMP_BROKER_TYPE=simple
# STOMP relay values are used only when STOMP_BROKER_TYPE=relay.
# RabbitMQ's STOMP plugin must be enabled separately from AMQP.
STOMP_RELAY_HOST=rabbitmq
STOMP_RELAY_PORT=61613
STOMP_RELAY_CLIENT_LOGIN=application
STOMP_RELAY_CLIENT_PASSCODE=replace-with-a-local-password
STOMP_RELAY_SYSTEM_LOGIN=application
STOMP_RELAY_SYSTEM_PASSCODE=replace-with-a-local-password


OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLING_PROBABILITY=1.0
DEPLOYMENT_ENVIRONMENT=local

